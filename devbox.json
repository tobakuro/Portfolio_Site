{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "git@latest",
    "gh@latest",
    "nodejs@24",
    "pnpm@latest",
    "go@latest"
  ],
  "shell": {
    "init_hook": [
      "echo '🚀 Devbox shell に入りました'",
      "echo '📖 よく使うコマンド, サーバー起動手順は docs/commands.md を参照'"
    ],
    "scripts": {
      "setup": [
        "cd frontend && pnpm install"
      ],
      "dev:front": [
        "cd frontend && pnpm dev"
      ],
      "dev:back": [
        "cd backend && go run ./..."
      ],
      "build": [
        "cd frontend && pnpm build"
      ],
      "test:front": [
        "cd frontend && pnpm test"
      ],
      "test:back": [
        "cd backend && go test ./..."
      ],
      "lint": [
        "cd frontend && pnpm lint"
      ],
      "typecheck": [
        "cd frontend && pnpm astro check"
      ]
    }
  },
  "env": {
    "PROJECT_ROOT": "$PWD"
  }
}
